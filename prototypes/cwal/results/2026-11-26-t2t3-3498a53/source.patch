+def cross3(k):
+    """One transaction over all three members, with markers ($txn)."""
+    return "begin\n" + "".join(f"insert into {s}.t values ({k}, $txn, 7, 3, randomblob(300))\n" for s in ("main", "m1", "m2")) + "!commit\n"
