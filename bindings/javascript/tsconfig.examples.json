{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "examples/dist",
    "baseUrl": ".",
    "paths": {
      "zova-js": ["dist/index.d.ts"]
    },
    "rootDir": "examples",
    "strict": true,
    "target": "ES2022"
  },
  "include": ["examples/*.ts"]
}
